---
interface ServiceItem {
  title: string;
  description: string;
  href?: string;
}

interface Props {
  topper?: string;
  heading?: string;
  description?: string;
  learnMoreLabel?: string;
  services?: ServiceItem[];
}

const icons = [
  // 1. Structural & Civil Works (Building / Architecture)
  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />',
  // 2. MEP Infrastructure (Power, Solar & Water)
  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />',
  // 3. Security & Architectural Metalwork (Reinforced Lock & Gate)
  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />',
  // 4. Finishes, Fit-Out & Interior Design (Tiling, Walls & Layout)
  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" />',
  // 5. Diaspora Liaison & Turnkey Rehabilitation (Global Reach & Bridge)
  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />',
  // 6. Legal, Permits & Municipal Liaison (Official Document / Permit)
  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />',
];

const {
  topper = 'Our Core Capabilities',
  heading = 'Clustered Construction & Rehabilitation Services',
  description = 'From immediate structural repairs to turnkey diaspora management, our integrated divisions deliver complete peace of mind in Khartoum.',
  learnMoreLabel = 'Learn more',
  services = [
    {
      title: 'Structural & Civil Works',
      description: 'Engineering damage assessments, foundation reinforcement, and masonry & concrete restoration (Bricks & Beton).',
      href: '/services',
    },
    {
      title: 'Mechanical, Electrical, Plumbing (MEP) Infrastructure',
      description: 'Complete power rewiring, solar/inverter setups, deep well pumps, water storage, and sanitary plumbing networks.',
      href: '/services',
    },
    {
      title: 'Security & Metalwork',
      description: 'Heavy-duty steel security gates, burglar-proof window grilles, reinforced doors, and perimeter wall fortification.',
      href: '/services',
    },
    {
      title: 'Finishes & Interior Design',
      description: 'Porcelain/ceramic tiling, custom doors and windows, weather-resistant exterior coatings, and turnkey interior fit-out.',
      href: '/services',
    },
    {
      title: 'Diaspora Turnkey Liaison',
      description: 'Owner’s representation for families abroad: video audits, transparent itemized milestones, and zero-headache execution.',
      href: '/services',
    },
    {
      title: 'Legal & Municipal Liaison',
      description: 'Navigating local authorities, property ownership verification, building permits, and public utility reconnections.',
      href: '/services',
    },
  ],
} = Astro.props;
---

<section class="bg-surface py-section">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
      <span class="text-topper font-bold uppercase tracking-widest text-accent">{topper}</span>
      <h2 class="mt-2 font-heading text-h2 font-bold uppercase text-text">{heading}</h2>
      <p class="mt-3 text-text-muted leading-relaxed">{description}</p>
    </div>

    <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" role="list">
      {services.map((service, i) => (
        <li>
          <a
            href={service.href || '/services'}
            aria-label={`${learnMoreLabel} - ${service.title}`}
            class="group flex h-full cursor-pointer flex-col rounded-lg border border-border bg-background p-6 shadow-sm transition-shadow duration-200 hover:shadow-md"
          >
            <div class="mb-4 flex size-12 items-center justify-center rounded-lg bg-primary/10 text-primary transition-colors group-hover:bg-primary group-hover:text-primary-fg">
              <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[i % icons.length]} />
            </div>
            <h3 class="font-heading text-h3 font-semibold text-text">{service.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-text-muted">{service.description}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-primary transition-colors group-hover:text-accent">
              {learnMoreLabel}
              <span class="sr-only"> - {service.title}</span>
              <svg class="size-4 transition-transform group-hover:translate-x-0.5 rtl:rotate-180 rtl:group-hover:-translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
