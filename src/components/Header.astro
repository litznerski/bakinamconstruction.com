---
import { brand } from '../config/brand';
import { client } from '../data/client';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/ui';
import LanguagePicker from './LanguagePicker.astro';
import BrandLogo from './BrandLogo.astro';

interface Props {
  lang?: Locale;
}

const { lang: propLang } = Astro.props;
const lang: Locale = propLang || (Astro.currentLocale as Locale) || getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isRtl = lang === 'ar';

const nav = [
  { label: t('nav.home'),     href: getLocalizedPath('/', lang) },
  { label: t('nav.about'),    href: getLocalizedPath('/about', lang) },
  { label: t('nav.services'), href: getLocalizedPath('/services', lang) },
  ...(brand.blog ? [{ label: t('nav.blog'),        href: getLocalizedPath('/blog', lang) }] : []),
  ...(brand.reviews ? [{ label: t('nav.reviews'),  href: getLocalizedPath('/reviews', lang) }] : []),
  { label: t('nav.contact'),  href: getLocalizedPath('/contact', lang) },
];

const currentPath = Astro.url.pathname;
const homeHref = getLocalizedPath('/', lang);
const contactHref = getLocalizedPath('/contact', lang);
---

<header
  class="sticky top-0 z-50 w-full border-b border-border bg-background/95 backdrop-blur-sm"
>
  <div class="mx-auto flex max-w-site items-center justify-between px-4 py-3 sm:px-6">
    <!-- Logo -->
    <a
      href={homeHref}
      class="inline-flex items-center transition-opacity hover:opacity-85"
      aria-label={brand.name}
    >
      <BrandLogo />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary navigation">
      {nav.map(({ label, href }) => {
        const isActive = currentPath === href || (href !== homeHref && currentPath.startsWith(href));
        return (
          <a
            href={href}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'rounded-md px-3 py-2 text-sm font-medium transition-colors',
              isActive
                ? 'bg-primary/10 text-primary'
                : 'text-text-muted hover:text-text',
            ]}
          >
            {label}
          </a>
        );
      })}
    </nav>

    <!-- Desktop CTA + phone + Language Picker -->
    <div class="hidden items-center gap-3.5 lg:flex">
      <LanguagePicker />

      <a
        href={`tel:${client.phoneForTel}`}
        class="inline-block text-sm font-semibold text-text hover:text-primary transition-colors"
        dir="ltr"
      >
        <bdi dir="ltr">{client.phoneFormatted}</bdi>
      </a>
      <a
        href={contactHref}
        class="inline-flex min-h-[44px] items-center rounded-md bg-accent px-5 py-2.5 text-sm font-bold text-accent-fg shadow-sm transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        {t('nav.contactBtn')}
      </a>
    </div>

    <!-- Mobile menu button -->
    <button
      id="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-md text-text-muted hover:bg-surface lg:hidden"
    >
      <span class="sr-only">Toggle menu</span>
      <svg id="menu-icon-open" class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="menu-icon-close" class="hidden size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile drawer -->
  <div
    id="mobile-menu"
    class="hidden border-t border-border bg-background px-4 pb-6 pt-2 lg:hidden"
  >
    <nav class="flex flex-col gap-1" aria-label="Mobile navigation">
      {nav.map(({ label, href }) => {
        const isActive = currentPath === href || (href !== homeHref && currentPath.startsWith(href));
        return (
          <a
            href={href}
            class:list={[
              'rounded-md px-3 py-3 text-base font-medium transition-colors',
              isActive
                ? 'bg-primary/10 text-primary'
                : 'text-text-muted hover:text-text hover:bg-surface',
            ]}
          >
            {label}
          </a>
        );
      })}
    </nav>

    <div class="mt-4 flex flex-col gap-3 border-t border-border pt-4">
      <div class="flex items-center justify-between px-2">
        <span class="text-xs font-semibold uppercase tracking-wider text-text-muted">Language / اللغة</span>
        <LanguagePicker />
      </div>

      <a
        href={`tel:${client.phoneForTel}`}
        class="flex items-center gap-2 px-3 py-2 text-base font-semibold text-text"
      >
        <svg class="size-5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <bdi dir="ltr">{client.phoneFormatted}</bdi>
      </a>
      <a
        href={contactHref}
        class="flex min-h-[44px] items-center justify-center rounded-md bg-accent px-5 py-3 text-base font-bold text-accent-fg shadow-sm transition-opacity hover:opacity-90"
      >
        {t('nav.contactBtn')}
      </a>
    </div>
  </div>
</header>

<script>
  function initHeader() {
    const header = document.querySelector('header');
    const btn = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    if (!header || !btn || !menu || !iconOpen || !iconClose) return;

    const activeClasses = ['bg-primary/10', 'text-primary'];
    const inactiveDesktop = ['text-text-muted', 'hover:text-text'];
    const inactiveMobile = ['text-text-muted', 'hover:text-text', 'hover:bg-surface'];

    const isDesktop = () => window.matchMedia('(min-width: 1024px)').matches;

    const setMenuOpen = (nextOpen: boolean) => {
      if (isDesktop()) nextOpen = false;
      btn.setAttribute('aria-expanded', String(nextOpen));
      menu.classList.toggle('hidden', !nextOpen);
      iconOpen.classList.toggle('hidden', nextOpen);
      iconClose.classList.toggle('hidden', !nextOpen);
    };

    function syncActiveLinks() {
      const path = window.location.pathname;
      const desktopLinks = header.querySelectorAll<HTMLAnchorElement>('nav[aria-label="Primary navigation"] a');
      const mobileLinks = header.querySelectorAll<HTMLAnchorElement>('#mobile-menu nav a');
      const isHomePath = (h: string) => h === '/' || h === '/ar' || h === '/ar/';

      desktopLinks.forEach((link) => {
        const href = link.getAttribute('href') || '';
        const isHome = isHomePath(href);
        const isActive = href === path || (!isHome && path.startsWith(href));
        link.classList.toggle(activeClasses[0], isActive);
        link.classList.toggle(activeClasses[1], isActive);
        link.classList.toggle(inactiveDesktop[0], !isActive);
        link.classList.toggle(inactiveDesktop[1], !isActive);
        if (isActive) link.setAttribute('aria-current', 'page');
        else link.removeAttribute('aria-current');
      });

      mobileLinks.forEach((link) => {
        const href = link.getAttribute('href') || '';
        const isHome = isHomePath(href);
        const isActive = href === path || (!isHome && path.startsWith(href));
        link.classList.toggle(activeClasses[0], isActive);
        link.classList.toggle(activeClasses[1], isActive);
        link.classList.toggle(inactiveMobile[0], !isActive);
        link.classList.toggle(inactiveMobile[1], !isActive);
        link.classList.toggle(inactiveMobile[2], !isActive);
        if (isActive) link.setAttribute('aria-current', 'page');
        else link.removeAttribute('aria-current');
      });
    }

    btn.onclick = () => {
      if (isDesktop()) return;
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      setMenuOpen(!isOpen);
    };

    menu.onclick = (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest('a[href]')) setMenuOpen(false);
    };

    window.onresize = () => setMenuOpen(false);

    setMenuOpen(false);
    syncActiveLinks();
  }

  document.addEventListener('astro:page-load', initHeader);
</script>
