---
import { getLangFromUrl, getSwitchLanguageUrl } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props {
  class?: string;
}

const currentLang: Locale = (Astro.currentLocale as Locale) || getLangFromUrl(Astro.url);
const targetLang: Locale = currentLang === 'en' ? 'ar' : 'en';
const targetLabel = targetLang === 'ar' ? 'العربية' : 'English';
const targetUrl = getSwitchLanguageUrl(Astro.url, targetLang);
const { class: className = '' } = Astro.props;
---

<a
  href={targetUrl}
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full border border-border bg-surface px-3 py-1.5 text-xs font-semibold text-text transition-colors hover:border-primary hover:text-primary',
    className,
  ]}
  aria-label={`Switch language to ${targetLabel}`}
  lang={targetLang}
  dir={targetLang === 'ar' ? 'rtl' : 'ltr'}
>
  <svg class="size-3.5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
  </svg>
  <span>{targetLabel}</span>
</a>
