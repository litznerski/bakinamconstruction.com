---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface GalleryItem {
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
}

interface Props {
  images: GalleryItem[];
  columns?: 2 | 3;
  aspectRatio?: 'aspect-4/3' | 'aspect-16/9' | 'aspect-square' | 'aspect-auto';
}

const {
  images = [],
  columns = 3,
  aspectRatio = 'aspect-4/3',
} = Astro.props;

const galleryId = `gallery-${Math.random().toString(36).substring(2, 9)}`;
---

<div class="my-8 w-full" id={galleryId} data-blog-gallery>
  <div
    class:list={[
      'grid gap-3 sm:gap-4',
      columns === 2 ? 'grid-cols-1 sm:grid-cols-2' : 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3',
    ]}
  >
    {
      images.map((item, idx) => {
        const isMetadata = typeof item.src === 'object';
        const displaySrc = isMetadata ? (item.src as ImageMetadata).src : (item.src as string);

        return (
          <figure class="group m-0 overflow-hidden rounded-lg border border-border bg-surface">
            <button
              type="button"
              class:list={[
                'block w-full overflow-hidden text-left cursor-zoom-in focus:outline-none focus-visible:ring-2 focus-visible:ring-primary',
                aspectRatio,
              ]}
              data-lightbox-trigger
              data-index={idx}
              data-img-src={displaySrc}
              data-img-alt={item.alt}
              data-img-caption={item.caption || item.alt}
            >
              {isMetadata ? (
                <Image
                  src={item.src as ImageMetadata}
                  alt={item.alt}
                  width={800}
                  height={600}
                  loading="lazy"
                  decoding="async"
                  class="size-full object-cover transition-transform duration-300 group-hover:scale-105"
                />
              ) : (
                <img
                  src={item.src as string}
                  alt={item.alt}
                  loading="lazy"
                  decoding="async"
                  class="size-full object-cover transition-transform duration-300 group-hover:scale-105"
                />
              )}
            </button>
            {item.caption && (
              <figcaption class="p-2.5 text-xs text-text-muted text-center border-t border-border/50 bg-background/50">
                {item.caption}
              </figcaption>
            )}
          </figure>
        );
      })
    }
  </div>

  <!-- Accessible Lightbox Modal Dialog -->
  <dialog
    class="fixed inset-0 z-50 m-0 p-0 size-full max-w-none max-h-none bg-black/90 backdrop-blur-md backdrop:bg-transparent border-0 hidden flex-col items-center justify-center"
    data-lightbox-modal
    aria-label="Image Preview"
  >
    <div class="relative flex flex-col items-center justify-center size-full p-4 sm:p-8">
      {/* Close button */}
      <button
        type="button"
        class="absolute top-4 right-4 z-10 flex size-10 items-center justify-center rounded-full bg-black/60 text-white hover:bg-black/80 transition-colors focus:outline-none focus:ring-2 focus:ring-white"
        data-lightbox-close
        aria-label="Close image preview"
      >
        <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      {/* Prev / Next buttons */}
      <button
        type="button"
        class="absolute left-4 top-1/2 -translate-y-1/2 z-10 flex size-10 items-center justify-center rounded-full bg-black/60 text-white hover:bg-black/80 transition-colors focus:outline-none focus:ring-2 focus:ring-white"
        data-lightbox-prev
        aria-label="Previous image"
      >
        <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <button
        type="button"
        class="absolute right-4 top-1/2 -translate-y-1/2 z-10 flex size-10 items-center justify-center rounded-full bg-black/60 text-white hover:bg-black/80 transition-colors focus:outline-none focus:ring-2 focus:ring-white"
        data-lightbox-next
        aria-label="Next image"
      >
        <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      {/* Main Lightbox Image */}
      <div class="flex flex-col items-center justify-center max-w-5xl max-h-[85vh]">
        <img
          src=""
          alt=""
          class="max-w-full max-h-[75vh] object-contain rounded-md shadow-2xl"
          data-lightbox-target
        />
        <p
          class="mt-3 text-center text-sm font-medium text-white/90 px-4 max-w-2xl"
          data-lightbox-caption
        ></p>
      </div>
    </div>
  </dialog>
</div>

<script>
  function setupGalleries() {
    document.querySelectorAll<HTMLElement>('[data-blog-gallery]').forEach((container) => {
      const triggers = Array.from(container.querySelectorAll<HTMLButtonElement>('[data-lightbox-trigger]'));
      const dialog = container.querySelector<HTMLDialogElement>('[data-lightbox-modal]');
      const closeBtn = container.querySelector<HTMLButtonElement>('[data-lightbox-close]');
      const prevBtn = container.querySelector<HTMLButtonElement>('[data-lightbox-prev]');
      const nextBtn = container.querySelector<HTMLButtonElement>('[data-lightbox-next]');
      const targetImg = container.querySelector<HTMLImageElement>('[data-lightbox-target]');
      const targetCaption = container.querySelector<HTMLElement>('[data-lightbox-caption]');

      if (!dialog || !targetImg || !targetCaption || triggers.length === 0) return;

      let currentIndex = 0;

      function updateModal(index: number) {
        if (index < 0) index = triggers.length - 1;
        if (index >= triggers.length) index = 0;
        currentIndex = index;

        const trigger = triggers[currentIndex];
        const src = trigger.getAttribute('data-img-src') || '';
        const alt = trigger.getAttribute('data-img-alt') || '';
        const caption = trigger.getAttribute('data-img-caption') || '';

        targetImg.src = src;
        targetImg.alt = alt;
        targetCaption.textContent = caption;
      }

      function openModal(index: number) {
        updateModal(index);
        dialog.classList.remove('hidden');
        dialog.classList.add('flex');
        if (typeof dialog.showModal === 'function') {
          dialog.showModal();
        }
      }

      function closeModal() {
        dialog.classList.add('hidden');
        dialog.classList.remove('flex');
        if (dialog.open && typeof dialog.close === 'function') {
          dialog.close();
        }
      }

      triggers.forEach((trigger) => {
        trigger.addEventListener('click', () => {
          const idx = parseInt(trigger.getAttribute('data-index') || '0', 10);
          openModal(idx);
        });
      });

      closeBtn?.addEventListener('click', closeModal);
      prevBtn?.addEventListener('click', () => updateModal(currentIndex - 1));
      nextBtn?.addEventListener('click', () => updateModal(currentIndex + 1));

      dialog.addEventListener('click', (e) => {
        if (e.target === dialog || (e.target as HTMLElement).tagName === 'DIALOG') {
          closeModal();
        }
      });

      dialog.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeModal();
        } else if (e.key === 'ArrowLeft') {
          updateModal(currentIndex - 1);
        } else if (e.key === 'ArrowRight') {
          updateModal(currentIndex + 1);
        }
      });
    });
  }

  setupGalleries();
  document.addEventListener('astro:page-load', setupGalleries);
  document.addEventListener('astro:after-swap', setupGalleries);
</script>
