---
/**
 * Base layout — wraps every page.
 *
 * Astro 6 features used:
 *  • <Font />         — built-in font optimizer from astro.config.mjs fonts array
 *  • <ClientRouter /> — client-side navigation with CSS transition animations
 */
import { Font, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { brand } from '../config/brand';
import { client } from '../data/client';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import LanguageDetector from '../components/LanguageDetector.astro';
import { getLangFromUrl, getLocalizedPath } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata | string;
  schema?: Record<string, unknown>;
  lang?: Locale;
}

const {
  title = brand.name,
  description = brand.description,
  image,
  schema,
} = Astro.props;

const lang: Locale = Astro.props.lang || (Astro.currentLocale as Locale) || getLangFromUrl(Astro.url);
const isRtl = lang === 'ar';
const dir = isRtl ? 'rtl' : 'ltr';

const pageTitle = title === brand.name ? title : `${title} - ${brand.name}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? brand.url);
const enURL = new URL(getLocalizedPath(Astro.url.pathname, 'en'), Astro.site ?? brand.url);
const arURL = new URL(getLocalizedPath(Astro.url.pathname, 'ar'), Astro.site ?? brand.url);

const siteUrl = Astro.site ?? brand.url;
let ogImageURL: string;
let ogImageWidth: number | undefined;
let ogImageHeight: number | undefined;

if (image && typeof image === 'object') {
  const optimized = await getImage({
    src: image,
    width: 1200,
    height: 630,
    format: 'jpeg',
    quality: 85,
  });
  ogImageURL = new URL(optimized.src, siteUrl).toString();
  ogImageWidth = optimized.attributes.width ? Number(optimized.attributes.width) : 1200;
  ogImageHeight = optimized.attributes.height ? Number(optimized.attributes.height) : 630;
} else if (typeof image === 'string' && image) {
  ogImageURL = new URL(image, siteUrl).toString();
} else {
  ogImageURL = new URL('/og-image.png', siteUrl).toString();
}
---

<html lang={lang} dir={dir} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="ar" href={arURL} />
    <link rel="alternate" hreflang="x-default" href={enURL} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:title"       content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImageURL} />
    <meta property="og:image:secure_url" content={ogImageURL} />
    {ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
    {ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
    <meta property="og:locale"      content={isRtl ? 'ar_SD' : 'en_US'} />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImageURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Fonts -->
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body"    preload />
    <Font cssVariable="--font-logo"    preload />

    <!-- JSON-LD Structured Data -->
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    <!-- FOUC prevention for dark mode -->
    <script is:inline>
      (function(){
        var t = localStorage.getItem('theme');
        if (t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark-mode');
        }
      })();
      document.addEventListener('astro:before-swap', function(e) {
        var newDoc = e.newDocument;
        if (!newDoc) return;
        var newDir = newDoc.documentElement.getAttribute('dir');
        var newLang = newDoc.documentElement.getAttribute('lang');
        if (newDir) document.documentElement.setAttribute('dir', newDir);
        if (newLang) document.documentElement.setAttribute('lang', newLang);
      });
    </script>

    <!-- Language Auto-Detection & Persistent Preference -->
    <LanguageDetector />

    <slot name="head" />
    <ClientRouter />
  </head>

  <body class="bg-background text-text font-body antialiased">
    <a
      class="sr-only focus:not-sr-only focus:absolute focus:z-[99999] focus:bg-primary focus:text-primary-fg focus:px-4 focus:py-2 focus:rounded-md"
      href="#main"
    >
      Skip to main content
    </a>

    <slot name="header" />

    <main id="main">
      <slot />
    </main>

    <slot name="footer" />

    <WhatsAppButton variant="floating" />
  </body>
</html>
