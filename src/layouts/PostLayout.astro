---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTA from '../components/CTA.astro';
import type { Locale } from '../i18n/ui';
import { getLocalizedPath } from '../i18n/utils';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  author?: string;
  lang?: Locale;
  image?: ImageMetadata | string;
}

const { title, description, date, author = 'Team', lang = 'en', image } = Astro.props;

const isRtl = lang === 'ar';
const formattedDate = date.toLocaleDateString(isRtl ? 'ar-EG' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const homeLabel = isRtl ? 'الرئيسية' : 'Home';
const blogLabel = isRtl ? 'المدونة' : 'Blog';
const backLabel = isRtl ? 'العودة إلى المدونة' : 'Back to Blog';
const homeHref = getLocalizedPath('/', lang);
const blogHref = getLocalizedPath('/blog', lang);
---

<BaseLayout lang={lang} title={title} description={description} image={image}>
  <Header slot="header" lang={lang} />

  <!-- Post hero -->
  <section class="bg-primary py-14 sm:py-16 lg:py-20 text-white">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <nav aria-label="Breadcrumb" class="mb-4">
        <ol class="flex items-center gap-1.5 text-sm text-primary-fg/70">
          <li><a href={homeHref} class="transition-colors hover:text-primary-fg">{homeLabel}</a></li>
          <li class="flex items-center gap-1.5">
            <svg class="size-3.5 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            <a href={blogHref} class="transition-colors hover:text-primary-fg">{blogLabel}</a>
          </li>
          <li class="flex items-center gap-1.5">
            <svg class="size-3.5 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            <span aria-current="page" class="text-primary-fg font-medium">{title}</span>
          </li>
        </ol>
      </nav>

      <h1 class="font-heading text-h1 font-bold uppercase text-primary-fg tracking-tight">{title}</h1>
      <div class="mt-3 flex items-center gap-3 text-sm text-primary-fg/80">
        <span class="font-medium">{author}</span>
        <span aria-hidden="true">&bull;</span>
        <time datetime={date.toISOString()}>{formattedDate}</time>
      </div>
    </div>
  </section>

  <!-- Post content -->
  <section class="py-section">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <article class="prose prose-lg max-w-none prose-headings:font-heading prose-headings:uppercase prose-a:text-primary hover:prose-a:underline prose-img:rounded-xl">
        <slot />
      </article>

      <div class="mt-12 border-t border-border pt-6">
        <a
          href={blogHref}
          class="inline-flex items-center gap-2 text-sm font-semibold text-primary transition-colors hover:text-primary-light"
        >
          <svg class="size-4 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
          </svg>
          {backLabel}
        </a>
      </div>
    </div>
  </section>

  <CTA lang={lang} />

  <Footer slot="footer" lang={lang} />
</BaseLayout>
