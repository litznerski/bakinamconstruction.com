---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Banner from '../../../components/Banner.astro';
import { client } from '../../../data/client';
---

<BaseLayout
  lang="ar"
  title="اتصل بنا | بكينام للمقاولات والهندسة"
  description="تواصل مع فريق بكينام للمقاولات في الخرطوم. احجز استشارة هندسية أو استفسر عن خدمات ترميم وبناء وتأمين المنازل."
>
  <Header slot="header" lang="ar" />

  <Banner title="اتصل بنا" />

  <section class="py-section">
    <div class="mx-auto grid max-w-site grid-cols-1 gap-10 px-4 sm:px-6 lg:grid-cols-5 lg:gap-14">

      <!-- Form -->
      <div class="lg:col-span-3">
        <h2 class="font-heading text-h2 font-bold uppercase text-text">أرسل لنا استفسارك</h2>
        <p class="mt-2 mb-8 text-text-muted">
          املأ النموذج أدناه وسيقوم فريقنا الهندسي بالتواصل معك خلال يوم عمل واحد.
        </p>

        <form
          name="contact"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          action="/ar/contact/success"
          class="flex flex-col gap-5"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden" aria-hidden="true">
            <label>Leave this empty: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>

          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-medium text-text">الاسم الكامل <span class="text-accent" aria-hidden="true">*</span></span>
            <input
              type="text"
              name="name"
              required
              autocomplete="name"
              class="min-h-[44px] rounded-md border border-border bg-background px-4 py-2.5 text-text transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
            />
          </label>

          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-medium text-text">البريد الإلكتروني <span class="text-accent" aria-hidden="true">*</span></span>
            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              class="min-h-[44px] rounded-md border border-border bg-background px-4 py-2.5 text-text transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
            />
          </label>

          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-medium text-text">رقم الهاتف أو الواتساب</span>
            <input
              type="tel"
              name="phone"
              autocomplete="tel"
              inputmode="tel"
              dir="ltr"
              class="min-h-[44px] rounded-md border border-border bg-background px-4 py-2.5 text-text text-right transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
            />
          </label>

          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-medium text-text">تفاصيل العقار أو الاستفسار <span class="text-accent" aria-hidden="true">*</span></span>
            <textarea
              name="message"
              rows="5"
              required
              class="min-h-[120px] rounded-md border border-border bg-background px-4 py-2.5 text-text transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 resize-y"
            ></textarea>
          </label>

          <button
            type="submit"
            class="mt-2 inline-flex min-h-[44px] cursor-pointer items-center justify-center self-start rounded-md bg-accent px-8 py-3 text-base font-bold text-accent-fg shadow-sm transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            إرسال الرسالة
          </button>
        </form>
      </div>

      <!-- Contact info sidebar -->
      <aside class="space-y-8 lg:col-span-2">
        <div>
          <h3 class="font-heading text-lg font-semibold text-text">الاتصال المباشر</h3>
          <a href={`tel:${client.phoneForTel}`} dir="ltr" class="mt-1 inline-block text-primary-light font-medium transition-colors hover:text-primary">
            <bdi dir="ltr">{client.phoneFormatted}</bdi>
          </a>
        </div>

        <div>
          <h3 class="font-heading text-lg font-semibold text-text">البريد الإلكتروني</h3>
          <a href={`mailto:${client.email}`} dir="ltr" class="mt-1 inline-block text-primary-light font-medium transition-colors hover:text-primary">
            <bdi dir="ltr">{client.email}</bdi>
          </a>
        </div>

        <div>
          <h3 class="font-heading text-lg font-semibold text-text">الموقع والمقر الميداني</h3>
          <a
            href={client.address.mapLink}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-1 block text-text-muted transition-colors hover:text-text leading-relaxed"
          >
            كافوري، مربع ٣<br />
            الخرطوم بحري، ولاية الخرطوم<br />
            السودان
          </a>
        </div>
      </aside>
    </div>
  </section>

  <Footer slot="footer" lang="ar" />
</BaseLayout>
