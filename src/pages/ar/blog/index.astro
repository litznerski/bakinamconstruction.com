---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Banner from '../../../components/Banner.astro';
import BlogSection from '../../../components/BlogSection.astro';
import CTA from '../../../components/CTA.astro';
---

<BaseLayout
  lang="ar"
  title="المدونة | باكينام للمقاولات والهندسة"
  description="قصص ومحطات وتحديثات من مشاريعنا الهندسية وإعادة تأهيل المنازل في كافوري والخرطوم."
>
  <Header slot="header" lang="ar" />

  <Banner title="المدونة" subtitle="قصص، محطات، وتحديثات ميدانية من مسيرتنا الهندسية في الخرطوم" />

  <BlogSection lang="ar" showHeading={false} />

  <CTA lang="ar" />

  <Footer slot="footer" lang="ar" />
</BaseLayout>
