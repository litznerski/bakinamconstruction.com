---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Banner from '../../../components/Banner.astro';
import CTA from '../../../components/CTA.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  lang="ar"
  title="المدونة | باكينام للمقاولات والهندسة"
  description="قصص ومحطات وتحديثات من مشاريعنا الهندسية وإعادة تأهيل المنازل في كافوري والخرطوم."
>
  <Header slot="header" lang="ar" />

  <Banner title="المدونة" subtitle="قصص، محطات، وتحديثات ميدانية من مسيرتنا الهندسية في الخرطوم" />

  <section class="py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      {posts.length === 0 ? (
        <div class="text-center py-12">
          <p class="text-text-muted text-lg">لا توجد مقالات منشورة حالياً. يرجى العودة قريباً!</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => {
            const formattedDate = post.data.date.toLocaleDateString('ar-EG', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            });
            return (
              <article class="group relative flex flex-col overflow-hidden rounded-xl border border-border bg-background shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
                <div class="flex flex-1 flex-col p-6 sm:p-7">
                  <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-accent">
                    <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
                    {post.data.tags.length > 0 && (
                      <>
                        <span aria-hidden="true">&bull;</span>
                        <span class="rounded bg-surface px-2 py-0.5 text-text-muted">{post.data.tags[0]}</span>
                      </>
                    )}
                  </div>

                  <h2 class="mt-3 font-heading text-h3 font-bold text-text group-hover:text-primary transition-colors line-clamp-2">
                    <a href={`/ar/blog/${post.id}`} class="after:absolute after:inset-0">
                      {post.data.title}
                    </a>
                  </h2>

                  <p class="mt-3 flex-1 text-sm leading-relaxed text-text-muted line-clamp-3">
                    {post.data.description}
                  </p>

                  <div class="mt-6 flex items-center justify-between border-t border-border/60 pt-4 text-xs text-text-muted">
                    <span>بقلم: {post.data.author}</span>
                    <span class="inline-flex items-center gap-1 font-bold text-primary group-hover:-translate-x-0.5 transition-transform">
                      اقرأ المقال
                      <svg class="size-3.5 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                    </span>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      )}
    </div>
  </section>

  <CTA lang="ar" />

  <Footer slot="footer" lang="ar" />
</BaseLayout>
