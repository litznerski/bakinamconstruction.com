---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../../layouts/PostLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data, id }) =>
    (data.lang === 'ar' || id.startsWith('ar/')) && data.status === 'public' && !data.draft
  );
  return posts.map((post) => ({
    params: { slug: post.id.replace(/^ar\//, '') },
    props: { post },
  }));
}

let { post } = Astro.props;
const { slug } = Astro.params;

if (!post || post.data?.lang !== 'ar') {
  const arPosts = await getCollection('blog', ({ data, id }) =>
    (data.lang === 'ar' || id.startsWith('ar/')) &&
    (id === `ar/${slug}` || id.replace(/^ar\//, '') === slug) &&
    data.status === 'public' &&
    !data.draft
  );
  if (arPosts.length > 0) {
    post = arPosts[0];
  }
}

if (!post) {
  return Astro.redirect('/ar/blog');
}

const { Content } = await render(post);
---

<PostLayout
  lang="ar"
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  author={post.data.author}
  image={post.data.image}
>
  <Content />
</PostLayout>
