---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import CTA from '../components/CTA.astro';
import { brand } from '../config/brand';

const services = [
  {
    title: '1. Structural & Civil Works (Core & Shell)',
    description: 'Restoring structural integrity and safety. Our civil engineering team performs comprehensive damage assessments, foundation inspections, load-bearing crack repairs, and heavy masonry and reinforced concrete work (Bricks & Beton).',
    trades: ['Civil engineering damage assessment', 'Foundation & structural crack repairs', 'Concrete slabs, columns & beams (Beton)', 'Brickwork & boundary wall reconstruction'],
  },
  {
    title: '2. MEP Infrastructure (Power, Solar & Water)',
    description: 'Re-establishing vital property utilities. We handle complete electrical rewiring, breaker panel replacements, solar and generator tie-ins, alongside deep well/borehole integration, booster pumps, overhead storage tanks, and sanitary piping.',
    trades: ['Complete electrical rewiring & panels', 'Solar power & generator integration', 'Water pumps & storage tank systems', 'Plumbing network & drainage restoration'],
  },
  {
    title: '3. Security & Architectural Metalwork',
    description: 'Fortifying your perimeter and securing every access point. We custom-fabricate heavy steel compound gates, burglar-proof window grilles, reinforced security doors, and install perimeter security barriers to give your property lasting protection.',
    trades: ['Custom metal compound gates', 'Burglar-proof window grilles & railings', 'Reinforced steel security doors', 'Perimeter wall raising & security barriers'],
  },
  {
    title: '4. Finishes, Fit-Out & Interior Design',
    description: 'Transforming a damaged structure into a pristine, welcoming home. From precision floor screeding and porcelain tiling to high-grade aluminum/UPVC windows, weather-resistant exterior coatings, smooth plastering, and turnkey interior design.',
    trades: ['Tiling & flooring (ceramic, porcelain, marble)', 'Doors & windows (aluminum, UPVC, wood)', 'Exterior weatherproofing & interior painting', 'Custom cabinetry & interior space design'],
  },
  {
    title: '5. Diaspora Liaison & Turnkey Rehabilitation',
    description: 'Our signature owner’s representative service for Sudanese families abroad. We provide complete oversight from initial video damage audits to move-in readiness, with milestone-based accounting and weekly photographic/video progress walkthroughs.',
    trades: ['Comprehensive video & photo property survey', 'Itemized transparent cost estimation', 'Weekly milestone updates & video reports', 'Turnkey management from abroad without stress'],
  },
  {
    title: '6. Legal, Permits & Municipal Liaison',
    description: 'Navigating bureaucratic hurdles on the ground. Led by our legal and regulatory counsel, we facilitate official property documentation verifications, building permits, neighborhood committee approvals, and public utility reconnections.',
    trades: ['Property ownership & title verification', 'Municipal permits & regulatory compliance', 'Public utility reconnection liaison', 'Contractor agreements & legal protection'],
  },
];

const icons = [
  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />',
  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />',
  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />',
  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" />',
  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />',
  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />',
];
---

<BaseLayout title="Construction & Rehabilitation Services" description={`Explore the clustered construction and home restoration services offered by ${brand.name} in Khartoum.`}>
  <Header slot="header" />

  <Banner title="Our Services" />

  <section class="py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
        <span class="text-topper font-bold uppercase tracking-widest text-accent">Comprehensive Solutions</span>
        <h2 class="mt-2 font-heading text-h2 font-bold uppercase text-text">Clustered Construction Services</h2>
        <p class="mt-3 text-text-muted leading-relaxed">
          We bring together engineering expertise, skilled trades, and European project management standards to inspect, secure, and restore homes in Khartoum.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        {services.map((service, i) => (
          <div class="flex flex-col justify-between rounded-lg border border-border bg-background p-6 shadow-sm sm:p-8">
            <div>
              <div class="mb-4 flex size-12 items-center justify-center rounded-lg bg-primary/10 text-primary">
                <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[i % icons.length]} />
              </div>
              <h3 class="font-heading text-xl font-bold uppercase text-text">{service.title}</h3>
              <p class="mt-3 text-text-muted leading-relaxed">{service.description}</p>
              
              <div class="mt-5 border-t border-border pt-4">
                <h4 class="text-xs font-semibold uppercase tracking-wider text-primary">Key Capabilities:</h4>
                <ul class="mt-2 space-y-1.5 text-sm text-text-muted" role="list">
                  {service.trades.map((trade) => (
                    <li class="flex items-center gap-2">
                      <svg class="size-4 shrink-0 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                      </svg>
                      <span>{trade}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="mt-6 pt-2">
              <a
                href="/contact"
                class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary transition-colors hover:text-accent"
              >
                Inquire about this service
                <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA />

  <Footer slot="footer" />
</BaseLayout>
