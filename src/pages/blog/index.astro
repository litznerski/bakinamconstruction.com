---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Banner from '../../components/Banner.astro';
import BlogSection from '../../components/BlogSection.astro';
import CTA from '../../components/CTA.astro';
import { brand } from '../../config/brand';
---

<BaseLayout
  lang="en"
  title="Blog | Bakinam Construction"
  description={`Stories, insights, and construction updates from ${brand.name} in Khartoum and Kafouri.`}
>
  <Header slot="header" lang="en" />

  <Banner title="Blog" subtitle="Stories, milestones, and updates from our construction journey in Khartoum" />

  <BlogSection lang="en" showHeading={false} />

  <CTA lang="en" />

  <Footer slot="footer" lang="en" />
</BaseLayout>
